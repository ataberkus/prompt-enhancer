{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (::e / ::en / ::ef / ::em)…"
					}
				]
			}
		],
		"UserPromptExpansion": [
			{
				"matcher": "^prompt-enhancer:enhance(-notest|-fast|-max)?$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (/enhance, /enhance-notest, /enhance-fast or /enhance-max)…"
					}
				]
			}
		]
	}
}
