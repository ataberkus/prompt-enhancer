{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (::e / ::ef)…"
					}
				]
			}
		],
		"UserPromptExpansion": [
			{
				"matcher": "^prompt-enhancer:enhance(-fast)?$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (/enhance or /enhance-fast)…"
					}
				]
			}
		]
	}
}
