{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (::e)…"
					}
				]
			}
		],
		"UserPromptExpansion": [
			{
				"matcher": "prompt-enhancer:enhance",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/index.mjs\"",
						"timeout": 300,
						"statusMessage": "✨ Enhancing prompt (/enhance)…"
					}
				]
			}
		]
	}
}
